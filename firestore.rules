rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 320
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048));
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('location' in data) || (data.location is string && data.location.size() <= 128))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 2048));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.role in ['user', 'model', 'system']
        && data.content is string && data.content.size() <= 10000;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('status' in data) || data.status in ['new', 'contacted', 'qualified', 'closed'])
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048));
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // User's Businesses
      match /businesses/{businessId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(businessId) && isValidBusiness(incoming());
        allow update: if isOwner(userId) && isValidId(businessId) && isValidBusiness(incoming());
        allow delete: if isOwner(userId) && isValidId(businessId);
      }

      // User's Chats & Messages
      match /chats/{chatId}/messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow delete: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
      }

      // User's CRM Leads
      match /leads/{leadId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(leadId) && isValidLead(incoming());
        allow update: if isOwner(userId) && isValidId(leadId) && isValidLead(incoming());
        allow delete: if isOwner(userId) && isValidId(leadId);
      }
    }
  }
}
