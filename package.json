{
  "name": "sandbox-app-template",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "cd packages/web && npm run dev",
    "build": "cd packages/web && npm run build",
    "build:web": "cd packages/web && npm run build",
    "start": "cd packages/web && npm run dev",
    "typecheck": "turbo typecheck",
    "lint": "runkit lint",
    "lint:fix": "runkit lint --fix"
  },
  "devDependencies": {
    "@runablehq/runkit": "0.1.1",
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "atmn": "1.1.8",
    "oxfmt": "0.54.0",
    "turbo": "2.9.18",
    "typescript": "7.0.1-rc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@google/genai": "^2.28.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0",
    "firebase": "^13.0.0",
    "pm2": "^7.0.1"
  }
}