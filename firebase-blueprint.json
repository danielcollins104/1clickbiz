{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with identification, email, and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 320 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "BusinessProject": {
      "title": "BusinessProject",
      "description": "A business concept created by the founder with generated assets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["draft", "active", "launched"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in a multi-turn Gemini conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 10000 },
        "modelUsed": { "type": "string", "maxLength": 64 },
        "groundingType": { "type": "string", "enum": ["none", "search", "maps"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "role", "content", "createdAt"]
    },
    "SavedLead": {
      "title": "SavedLead",
      "description": "A customer or partner lead tracked in the founder CRM",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 320 },
        "status": { "type": "string", "enum": ["new", "contacted", "qualified", "closed"] },
        "notes": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile data"
    },
    "/users/{userId}/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/BusinessProject" },
      "description": "Stores user businesses and generated startup projects"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Stores conversation history for the Gemini AI Advisor"
    },
    "/users/{userId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/SavedLead" },
      "description": "Stores CRM leads captured or entered for the user business"
    }
  }
}
